pipeline {
    agent any

    environment {
        PYTHON_HOME = '/Users/karan.pandhare/PytestSample/pytest-example/venv/bin/python'  // Virtual environment Python path
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'develop5', url: 'https://github.com/KAR0203/pytest-example.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    // Example of aborting the build if a condition is met
                    def conditionToAbort = true  // This is just an example condition
                    echo "Checking condition to abort: ${conditionToAbort}"

                    if (conditionToAbort) {
                        echo 'Aborting the build due to a condition being met.'
                        // Set the build result to failure and stop further execution
                        currentBuild.result = 'FAILURE'
                        return  // Exit the pipeline early, no need to run further stages
                    }

                    // Create the virtual environment if it doesn't exist
                    sh '${PYTHON_HOME} -m venv venv'  // Create virtual environment
                    sh './venv/bin/pip install -r requirements.txt'  // Install dependencies
                }
            }
        }

        // Skip this stage if the build is aborted
        stage('Run Tests') {
            when {
                expression { currentBuild.result != 'FAILURE' }
            }
            steps {
                script {
                    // This stage won't run if the build is aborted in the previous stage
                    sh './venv/bin/pytest --junitxml=results.xml'  // Run tests and generate results.xml
                }
            }
        }
    }

    post {
        always {
            // Clean up (optional)
            echo 'Cleaning up...'
            sh 'rm -rf venv'
        }

        success {
            echo 'Build and tests succeeded!'
        }

        failure {
            echo 'Build or tests failed!'
            // Publish test results after the build is complete (this will run if the build fails)
            junit '**/results.xml'  // Publish the results.xml test report only if tests ran
        }
    }
}
