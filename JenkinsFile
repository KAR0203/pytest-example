pipeline {
    agent any

    parameters {
        // Parameter to specify the Git branch to checkout
        string(name: 'BRANCH_NAME', defaultValue: 'develop2', description: 'The branch to checkout')

        // Parameter to specify the Python executable path
        string(name: 'PYTHON_HOME', defaultValue: '/Users/karan.pandhare/PytestSample/pytest-example/venv/bin/python', description: 'Path to the Python executable')

        // Optional: Boolean parameter to decide if tests should run
        booleanParam(name: 'RUN_TESTS', defaultValue: true, description: 'Whether to run tests or not')
    }

    environment {
        // Using the parameterized PYTHON_HOME instead of a static value
        PYTHON_HOME = "${params.PYTHON_HOME}"
    }

    stages {
        stage('Checkout') {
            steps {
                echo "Checking out branch: ${params.BRANCH_NAME}"
                git branch: "${params.BRANCH_NAME}", url: 'https://github.com/KAR0203/pytest-example.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    def conditionToAbort = false // Ensure this condition is false, no aborting will happen
                    echo "Checking condition to abort: ${conditionToAbort}"

                    // Log the condition instead of aborting
                    if (conditionToAbort) {
                        echo 'Condition met, but we will NOT abort the build.'
                    } else {
                        echo 'Condition not met, proceeding with installation of dependencies.'
                    }

                    echo "Installing dependencies..."
                    sh '${PYTHON_HOME} -m venv venv'
                    sh './venv/bin/pip install -r requirements.txt'
                }
            }
        }

        stage('Run Tests') {
            when {
                // Only run tests if RUN_TESTS parameter is true and the build wasn't aborted
                expression { params.RUN_TESTS && currentBuild.result != 'ABORTED' }
            }
            steps {
                script {
                    echo "Running tests..."
                    sh './venv/bin/pytest --junitxml=results.xml'
                }
            }
        }
    }

    post {
        always {
            echo 'Cleaning up...'
            sh 'rm -rf venv'
        }

        success {
            echo 'Build and tests succeeded!'
            junit '**/results.xml'
        }

        failure {
            echo 'Build or tests failed!'
        }

        aborted {
            echo 'Build was aborted, no tests were run.'
        }
    }
}
